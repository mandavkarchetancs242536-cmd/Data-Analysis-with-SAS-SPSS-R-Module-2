install.packages("ggplot2")
install.packages("dplyr")


library(ggplot2)
library(dplyr)


ai_jobs <- read.csv("ai_jobs.csv")


str(ai_jobs)
head(ai_jobs)


ggplot(ai_jobs, aes(x = experience_level)) +
  geom_bar() +
  labs(
    title = "Job Distribution by Experience Level",
    x = "Experience Level",
    y = "Number of Jobs"
  ) +
  theme_minimal()


ggplot(ai_jobs, aes(x = remote_type)) +
  geom_bar() +
  labs(
    title = "Jobs by Work Mode",
    x = "Work Mode",
    y = "Number of Jobs"
  ) +
  theme_minimal()


ggplot(ai_jobs, aes(x = experience_level, y = salary_max_usd)) +
  geom_boxplot() +
  labs(
    title = "Salary Distribution by Experience Level",
    x = "Experience Level",
    y = "Maximum Salary (USD)"
  ) +
  theme_minimal()


ggplot(ai_jobs, aes(x = min_experience_years, y = salary_max_usd)) +
  geom_point() +
  labs(
    title = "Experience vs Maximum Salary",
    x = "Minimum Experience (Years)",
    y = "Maximum Salary (USD)"
  ) +
  theme_minimal()


ggplot(ai_jobs, aes(x = industry)) +
  geom_bar() +
  labs(
    title = "Number of Jobs by Industry",
    x = "Industry",
    y = "Number of Jobs"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))


ggplot(ai_jobs, aes(x = posted_year)) +
  geom_bar() +
  labs(
    title = "AI Jobs Posted Per Year",
    x = "Year",
    y = "Number of Jobs"
  ) +
  theme_minimal()


