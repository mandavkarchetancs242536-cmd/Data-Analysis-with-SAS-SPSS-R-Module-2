install.packages("ggplot2")

library(ggplot2)


water_data <- read.csv("Daily_Water_Intake.csv")


head(water_data)
str(water_data)


colnames(water_data)[colnames(water_data) == "Daily.Water.Intake..liters."] <- "Water_Intake_Liters"


colnames(water_data)


ggplot(water_data, aes(x = Water_Intake_Liters)) +
  geom_histogram(binwidth = 0.5) +
  labs(
    title = "Histogram of Daily Water Intake",
    x = "Water Intake (Liters)",
    y = "Frequency"
  ) +
  theme_minimal()


ggplot(water_data, aes(x = Water_Intake_Liters)) +
  geom_histogram(binwidth = 0.5) +
  facet_wrap(~ Gender) +
  labs(
    title = "Histogram of Daily Water Intake by Gender",
    x = "Water Intake (Liters)",
    y = "Frequency"
  ) +
  theme_minimal()


ggplot(water_data, aes(y = Water_Intake_Liters)) +
  geom_boxplot() +
  labs(
    title = "Box Plot of Daily Water Intake",
    y = "Water Intake (Liters)"
  ) +
  theme_minimal()


ggplot(water_data, aes(x = Gender, y = Water_Intake_Liters)) +
  geom_boxplot() +
  labs(
    title = "Box Plot of Daily Water Intake by Gender",
    x = "Gender",
    y = "Water Intake (Liters)"
  ) +
  theme_minimal()


